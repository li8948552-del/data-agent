# Required for live LLM calls
LLM_API_KEY=

# OpenAI-compatible endpoint/model
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6
EMBEDDING_MODEL=text-embedding-3-small

# Local PostgreSQL defaults
DB_URL=jdbc:postgresql://localhost:5432/data_agent
DB_USER=data_agent
DB_PASSWORD=data_agent

PORT=9933
